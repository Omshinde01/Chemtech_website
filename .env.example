# Copy this file to .env and fill it in. NEVER commit .env.

# Required. API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Required. Inbox for quote requests. Comma-separate for several.
MAIL_TO=you@example.com

# Must use a domain verified in Resend. The default, onboarding@resend.dev, only
# delivers to the Resend account owner.
MAIL_FROM=Chemtech Specialty <info@chemtechspecialty.com>

# Optional. Server port (default 5000).
# PORT=5000

# Needed when the site is on a different domain than this server (its www/apex
# counterpart is allowed automatically).
# CORS_ORIGIN=https://chemtechspecialty.com

# Build-time, for the site: origin of the API when it's on another domain.
# VITE_API_URL=https://your-api.onrender.com
