# Copy this file to .env and fill it in. NEVER commit .env.

# Where quote requests are delivered (your inbox). Comma-separate for several.
MAIL_TO=you@example.com

# SMTP account used to send the notification.
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional. Defaults to SMTP_USER. Must be an address your SMTP account is allowed to send as.
# MAIL_FROM=you@gmail.com

# Optional. Server port (default 5000).
# PORT=5000

# Optional. Only if the React site is hosted on a different domain than this server.
# CORS_ORIGIN=https://www.yourdomain.com
